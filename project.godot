config_version=5

[application]

config/name="Uniloop"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="Offline single-wheel momentum racing"
run/main_scene="res://scenes/menu.tscn"
config/icon="res://AppStore/icon.png"
config/windows_native_icon="res://AppStore/icon.ico"
boot_splash/bg_color=Color(0.11, 0.03, 0.2, 1)
boot_splash/stretch_mode=4
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/minimum_display_time=600

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

